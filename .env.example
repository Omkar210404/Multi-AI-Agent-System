# Copy to .env and edit. Never commit .env.

# "mock" runs fully offline with placeholder answers (no key needed).
# "openai_compatible" works with any OpenAI-compatible Chat Completions API.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=mock-model
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1200
# Only for reasoning models such as openai/gpt-oss-120b (low = faster, fewer tokens). Leave empty otherwise.
LLM_REASONING_EFFORT=

# Optional: a different model per agent on the same provider (JSON; agents not listed use LLM_MODEL).
# Tested Groq setup:
# LLM_AGENT_MODELS='{"router": {"model": "openai/gpt-oss-20b", "reasoning_effort": "low"}, "knowledge_agent": {"model": "qwen/qwen3.8-27b"}, "communication_agent": {"model": "qwen/qwen3.8-27b"}, "coding_agent": {"model": "openai/gpt-oss-120b", "reasoning_effort": "low"}, "reasoning_agent": {"model": "openai/gpt-oss-120b", "reasoning_effort": "low"}, "fact_check_agent": {"model": "openai/gpt-oss-20b", "reasoning_effort": "low"}}'

# Examples (uncomment one block):
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b  LLM_REASONING_EFFORT=low
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=<provider/model>
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=llama3.1  LLM_API_KEY=ollama

# Optional backup provider: used automatically when the primary is rate-limited, times out or errors.
# "none" disables it. Example (Google Gemini, key from https://aistudio.google.com/apikey):
#   LLM_FALLBACK_PROVIDER=openai_compatible
#   LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_FALLBACK_MODEL=gemini-flash-lite-latest
#   LLM_FALLBACK_REASONING_EFFORT=low
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_REASONING_EFFORT=

# Fact-check search backend: "none" (claims reported as unverified) or "wikipedia" (keyless, needs internet)
SEARCH_PROVIDER=none

MEMORY_MAX_MESSAGES=10
TRACE_STORE_SIZE=500
LOG_LEVEL=INFO
